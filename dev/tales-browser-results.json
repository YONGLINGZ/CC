    {
      "chain": "letter",
      "stages": [
        {
          "step": 1,
          "src": "assets/events/tale_letter_1.webp",
          "outcome": "阿筠把信交给你，提醒你信里还有活人的住处。你答应送达，不答应替任何人解释。"
        },
        {
          "step": 2,
          "src": "assets/events/tale_letter_2.webp",
          "outcome": "家属哭完后要求留下复本。她说不替死者开脱，也不想让旁人用她的悲痛代为表态。"
        },
        {
          "step": 3,
          "src": "assets/events/tale_letter_3.webp",
          "outcome": "你们留下有出处的副本，写清谁亲眼见过，谁只是转述。空白没有被好听的结论填满。"
        }
      ]
    },
    {
      "chain": "name",
      "stages": [
        {
          "step": 1,
          "src": "assets/events/tale_name_1.webp",
          "outcome": "你没有替身份作保，只请守关者先看伤。他把玉牌藏得更深，低声道谢。"
        },
        {
          "step": 2,
          "src": "assets/events/tale_name_2.webp",
          "outcome": "许渡承认借走衣袍，原主确认他没有乘伤害人。守关者给了限期伤籍，没有把冒名说成从未发生。"
        },
        {
          "step": 3,
          "src": "assets/events/tale_name_3.webp",
          "outcome": "两个人各系了一半绳结。你收下的是今日的谢意，没有抹去昨日的责任。"
        }
      ]
    },
    {
      "chain": "lanterns",
      "stages": [
        {
          "step": 1,
          "src": "assets/events/tale_lanterns_1.webp",
          "outcome": "她给你添了热水。帘后那只手停住，像在等你问一句，却最终没有开口。"
        },
        {
          "step": 2,
          "src": "assets/events/tale_lanterns_2.webp",
          "outcome": "你坐在两人之间，只在孟清被打断时请她继续说。孟夫人没有立刻理解，但第一次叫对了名字。"
        },
        {
          "step": 3,
          "src": "assets/events/tale_lanterns_3.webp",
          "outcome": "灯珠只是一盏灯的余温，不承诺让谁回来，也不要求收下的人永远留下。"
